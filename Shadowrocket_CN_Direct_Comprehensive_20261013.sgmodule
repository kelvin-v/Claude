#!name=中国国内服务直连·全面版 2026-10-13
#!desc=国内常用服务/头条字节系直连；配合 Claude_DNS_Overlay 的 DIRECT/PROXY 分流解析；保留海外 Claude/AI 规则与 IPv6 策略。
#!author=kelvin-v / ChatGPT

# 配合本仓库 Claude_DNS_Overlay.sgmodule。两者同时启用，但不要同时启用两个 DNS 覆写模块。
# 保留 Claude_All_Services_Shadowrocket_v3.sgmodule 和 Claude_IPv6_Leak_Guard.sgmodule 原样；勿启用旧 CN Direct 模块。
# 规则只有 DIRECT/PROXY，无 MITM、脚本、重写或 DNS 覆写。
# ByteDance 仅从 blackmatrix7/ios_rule_script 2026-10-04 规则中提取 DOMAIN / DOMAIN-SUFFIX，忽略 TikTok UA 和 IP。
# ByteDance 共享的 bytedance.com/net/org 不强制直连，以减少影响海外 TikTok/CapCut 的可能。
# 其他行业采用第三方持续更新 RULE-SET，首次加载需要能访问 raw.githubusercontent.com。
# 使用 Configuration 路由模式；命中 DIRECT 走直连 DNS，PROXY/未知按已有 DNS 模块走代理。
# 规则集由第三方维护；若与特定跨境服务冲突，应在本模块前设置更具体 PROXY 例外并重新验证。

[Rule]
# 海外服务优先，避免字节生态共享域名误伤国际 App
DOMAIN-SUFFIX,tiktok.com,PROXY
DOMAIN-SUFFIX,tiktokv.com,PROXY
DOMAIN-SUFFIX,tiktokcdn.com,PROXY
DOMAIN-SUFFIX,tiktokcdn-us.com,PROXY
DOMAIN-SUFFIX,tiktokrow.com,PROXY
DOMAIN-SUFFIX,tiktokmusic.app,PROXY
DOMAIN-SUFFIX,capcut.com,PROXY
DOMAIN-SUFFIX,capcut.net,PROXY
DOMAIN-SUFFIX,lemon8-app.com,PROXY
DOMAIN-SUFFIX,byteplus.com,PROXY
DOMAIN-SUFFIX,bytedance.com,PROXY
DOMAIN-SUFFIX,bytedance.net,PROXY
DOMAIN-SUFFIX,bytedance.org,PROXY

# 常见中国域名通用直连（不添加 .ms 等可能影响其他地区的 TLD）
DOMAIN-SUFFIX,cn,DIRECT

# 头条 / 抖音 / 西瓜 / 番茄 / 飞书 / 火山引擎等国内字节生态（独立域名条目）
