DOMAIN-SUFFIX,box.com,PROXY

# --- Official Anthropic inbound ranges, outbound-only expansion and ASN/BGP ---
IP-CIDR,160.79.104.0/23,PROXY,no-resolve
IP-CIDR,160.79.104.0/21,PROXY,no-resolve
IP-CIDR6,2607:6bc0::/48,PROXY,no-resolve
IP-CIDR6,2607:6bc0:11::/48,PROXY,no-resolve
IP-ASN,399358,PROXY,no-resolve

# --- Additional original v2 exact matches (preserved) ---
DOMAIN,featureassets.org,PROXY
DOMAIN,assetsconfigcdn.org,PROXY
DOMAIN,prodregistryv2.org,PROXY
DOMAIN,beyondwickedmapping.org,PROXY

