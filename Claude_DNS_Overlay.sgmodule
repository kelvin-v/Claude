#!name=Claude DNS Overlay
#!desc=China-first encrypted DNS for Johnshall split routing; remote proxy-domain resolution retained; system DNS fallback and unsupported UDP direct fallback disabled.
#!author=ChatGPT

# DNS performance revision 2026-10-11.
# Domestic app slowdown was observed with proxied Google/Cloudflare DoH, and cleared when this overlay was disabled.
# Keep DoH for default, DIRECT and fallback DNS; no overseas resolver on the normal lookup path.
# Proxy-routed domains are generally resolved by the proxy server, but device-specific behavior needs log validation.
# Node bootstrap uses normal default encrypted DNS, not a separate possibly blocked DoT/853 connection.
# DNS provider can still see locally resolved names. This does not guarantee a zero-DNS-leak device.
# Retain current Claude proxy and IPv6 Leak Guard modules; no routing rules are changed here.
# IMPORTANT: If performance or Claude connectivity worsens, disable this module and retest.

[General]
dns-server = https://dns.alidns.com/dns-query,https://doh.pub/dns-query
direct-dns-server = https://dns.alidns.com/dns-query,https://doh.pub/dns-query
fallback-dns-server = https://dns.alidns.com/dns-query,https://doh.pub/dns-query
dns-direct-system = false
dns-fallback-system = false
dns-direct-fallback-proxy = false
udp-policy-not-supported-behaviour = REJECT
